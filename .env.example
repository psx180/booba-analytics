# =============================================================================
# Database
# =============================================================================
# SQLite connection string for Prisma. Local file by default; swap for hosted
# Postgres/MySQL by changing the protocol.
DATABASE_URL="file:./prisma/dev.db"

# =============================================================================
# Auth (Privy)
# =============================================================================
# Privy app ID — obtain from the Privy dashboard. Exposed to the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy server secret — used by API routes to verify session tokens. Never expose.
PRIVY_APP_SECRET=
# Optional dev bypass — when set, the app treats this Solana address as the
# logged-in user without requiring a wallet connection. Leave blank in prod.
NEXT_PUBLIC_DEV_WALLET=

# =============================================================================
# Pacifica API
# =============================================================================
# Pacifica mainnet API key — required for authenticated REST calls and trade ingest.
PF_API_KEY=
# Pacifica testnet API key — used when the network selector is set to testnet.
PACIFICA_TESTNET_API_KEY=
# Pacifica REST base URL for the carry trade service (loan_pool / spot_assets /
# account / loan endpoints). Pin to testnet until these go live on mainnet.
PACIFICA_CARRY_API_URL=https://test-api.pacifica.fi

# =============================================================================
# AI (Anthropic)
# =============================================================================
# Anthropic API key — powers Booba chat, thesis parsing, novel pattern detection,
# and post-mortem generation.
ANTHROPIC_API_KEY=

# =============================================================================
# Integrations
# =============================================================================
# Shared secret required by webhook/bot endpoints (e.g. POST /api/bot/*).
BOT_API_KEY=
# Wallet address used by background jobs and webhook ingest when no user is attached.
DEFAULT_WALLET_ADDRESS=
# HMAC secret for verifying inbound TradingView webhook alerts.
TRADINGVIEW_WEBHOOK_SECRET=
# Telegram bot webhook URL for outbound mobile alerts. Leave blank to disable.
TELEGRAM_NOTIFY_URL=
