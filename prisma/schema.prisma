


// Booba — Pacifica Hackathon
// Schema for trading journal, unified margin suite, and Booba AI agent

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Journals ──────────────────────────────────────────────────────────────────
//
// A journal is an independent slice of trading data with its own analytics —
// own equity curve, own Elo, own insights. Use cases: mainnet vs testnet,
// market-making vs directional, isolating a focused time period. Positions
// are the unit of journal assignment; orders/fills follow via relations.
//
// Every wallet has exactly one default journal ("All Trades"), seeded on
// first import. Positions with journalId == null are treated as belonging to
// the default journal at query time (legacy data and resilience against
// cleared assignments).

model Journal {
  id            String     @id @default(cuid())
  walletAddress String
  name          String                                 // e.g., 'Main Trading', 'Testnet Practice', 'Market Making'
  description   String?
  isDefault     Boolean    @default(false)              // exactly one default journal per wallet
  filters       String?                                 // JSON — optional auto-filter rules (e.g., {"asset":"BTC"})
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  startingCapital        Float?
  startingCapitalSource  String?

  // Slow-tier analytics state — 'computing' while MFE/MAE + regime tagging
  // is running after an import, 'ready' once done. Null for wallets that
  // haven't imported yet. Drives the dashboard's "deep analytics computing"
  // banner. Wallet-level status (all journals for a wallet share a value).
  analyticsStatus        String?

  positions     Position[]

  @@index([walletAddress])
}

// ─── Strategies ────────────────────────────────────────────────────────────────

model Strategy {
  id                String   @id @default(cuid())
  walletAddress     String?
  name              String   @unique
  directionBias     String?  // long_only | short_only | both
  preferredRegime   String?  // trending_low_vol | trending_high_vol | ranging_low_vol | ranging_high_vol
  typicalTimeframe  String?  // scalp | intraday | swing | carry
  description       String?
  entrySignalTags   String?  // JSON array of tag strings
  typicalRrTarget   Float?
  checklist         String?  // JSON array of { name, category }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trades            Trade[]
  positions         Position[]
  boobaObservations BoobaObservation[]
}

// ─── Linked Strategies (delta neutral, pairs trade, basis trade) ──────────────

model LinkedStrategy {
  id              String    @id @default(cuid())
  walletAddress   String?
  strategyType    String    // delta_neutral | pairs_trade | basis_trade
  combinedPnl     Float?
  combinedFees    Float?
  combinedFunding Float?
  netDelta        Float?
  spreadPnl       Float?
  status          String    @default("open") // open | closed
  confidence      Float?
  tradeType       String?
  firstEntryTime  DateTime?
  lastExitTime    DateTime?
  thesis          String?
  customData      String?   // JSON
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  positions       Position[]
}

// ─── Positions (the primary analytical unit) ──────────────────────────────────

model Position {
  id                  String          @id @default(cuid())
  walletAddress       String?
  asset               String
  direction           String          // long | short
  status              String          @default("open") // open | closed
  averageEntryPrice   Float?
  averageExitPrice    Float?
  totalSize           Float?
  aggregatePnl        Float?
  aggregateFees       Float?
  aggregateFunding    Float?
  holdTimeSeconds     Int?
  mfePrice            Float?
  mfePnl              Float?
  maePrice            Float?
  maePnl              Float?
  confidence          Float?
  groupingConfirmed   Boolean         @default(false) // true when user has manually merged, split, or reclassified
  tradeType           String?         // scalp | directional | scaled_directional | carry_trade | market_making
  manualTradeType     String?         // user override; COALESCE with tradeType for effective type
  regimeAtEntry       String?
  sentimentAtEntry    String?
  sentimentScore      Float?
  firstEntryTime      DateTime?
  lastExitTime        DateTime?
  thesis              String?
  invalidationPrice   Float?
  targetPrice         String?         // JSON array for multiple targets
  stopType            String?         // candle_close | trailing | partial_tp | fixed
  conviction          Int?            // 1-3
  // Analytics metrics (computed by metric computers)
  exitEfficiency      Float?
  moneyLeftOnTable    Float?
  maeRatio            Float?
  entryHour           Int?
  entryDayOfWeek      Int?
  entrySession        String?         // asian | european | us
  holdTimeCategory    String?         // scalp | intraday | swing | position
  // Tilt detection (computed by tilt service)
  tiltScore           Float?
  tiltEpisodeId       String?
  tiltFeatures        String?         // JSON: TiltScore.features object
  // Advanced analytics (computed by xpnl/elo metric computers)
  xpnl                Float?
  eloAtTrade          Float?
  // User-annotated tags (set via trade detail modal / Phase 2 popup)
  strategyTag         String?
  sourceTag           String?
  emotion             String?
  mistakes            String?         // JSON array of mistake tags

  // Trade annotation fields (set via post-trade popup / detail modal)
  confirmation        String?         // What confirmed the entry? (free text)

  // Playbook adherence (set when user tags a playbook; auto-computed on import/tag)
  playbookId          String?
  adherenceScore      Float?          // 0-100, percentage of enabled non-inconclusive rules passed
  adherenceDetail     String?         // JSON: RuleResult[]

  // Social context at time of entry (populated by ELFA enrichment)
  socialSentiment    Float?           // -1 to 1 at time of entry
  socialMentions     Int?             // mention count at time of entry
  socialMindshare    Float?           // % of total discussion at time of entry

  screenshot          String?         // base64 data URL of chart at entry time
  customData          String?         // JSON
  linkedStrategyId    String?
  linkedStrategy      LinkedStrategy? @relation(fields: [linkedStrategyId], references: [id])
  strategyId          String?
  strategy            Strategy?       @relation(fields: [strategyId], references: [id])
  // Journal assignment — null means "in the wallet's default journal" (legacy
  // rows) and is resolved at query time. New positions are always written
  // with an explicit journalId.
  journalId           String?
  journal             Journal?        @relation(fields: [journalId], references: [id])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  orderGroups         OrderGroup[]

  @@index([journalId])
}

// ─── Order Groups (fills grouped by order) ────────────────────────────────────

model OrderGroup {
  id                String    @id @default(cuid())
  walletAddress     String?
  asset             String
  direction         String    // long | short
  status            String    @default("open") // open | closed
  averageEntryPrice Float?
  averageExitPrice  Float?
  totalSize         Float?
  aggregatePnl      Float?
  aggregateFees     Float?
  aggregateFunding  Float?
  confidence        Float?
  ruleSource        String?
  tradeType         String?   // partial_fill | twap | single
  firstEntryTime    DateTime?
  lastExitTime      DateTime?
  rawMetadata       String?   // JSON
  positionId        String?
  position          Position? @relation(fields: [positionId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trades            Trade[]
}

// ─── Trades (individual fills) ────────────────────────────────────────────────

model Trade {
  id                String      @id @default(cuid())
  walletAddress     String?
  asset             String
  direction         String      // long | short
  size              Float
  entryPrice        Float
  exitPrice         Float?
  entryTime         DateTime?
  exitTime          DateTime?

  pnlRealized       Float?
  fees              Float?
  fundingEarned     Float?
  fundingPaid       Float?
  holdTimeSeconds   Int?

  mfePrice          Float?
  mfePnl            Float?
  maePrice          Float?
  maePnl            Float?

  regimeAtEntry     String?     // trending_low_vol | trending_high_vol | ranging_low_vol | ranging_high_vol
  sentimentAtEntry  String?
  sentimentScore    Float?

  strategyId        String?
  strategy          Strategy?   @relation(fields: [strategyId], references: [id])
  orderGroupId      String?
  orderGroup        OrderGroup? @relation(fields: [orderGroupId], references: [id])

  sourceTag         String?
  tradeType         String?     // directional | carry | delta_neutral | market_making | liquidation_acquisition
  subaccount        String?
  builderCode       String?
  cause             String?     // normal | market_liquidation | backstop_liquidation | settlement (from Pacifica API)
  captureMode       String      @default("retroactive") // retroactive | live

  // Phase 2 popup fields
  thesis            String?
  invalidationPrice Float?
  targetPrice       String?     // JSON array for multiple targets
  stopType          String?     // candle_close | trailing | partial_tp | fixed
  conviction        Int?        // 1-3

  customData        String?     // JSON escape hatch
  rawData           String?     // full raw API response JSON

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  fundingHistory    FundingHistory[]
  alerts            Alert[]
}

// ─── Custom Stat Definitions ───────────────────────────────────────────────────

model CustomStatDefinition {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   // number | text | select
  options   String?  // JSON array of allowed values (for select type)
  createdAt DateTime @default(now())
}

// ─── Booba Observations ────────────────────────────────────────────────────────

model BoobaObservation {
  id                String    @id @default(cuid())
  walletAddress     String?
  // Journal scope — observations are derived from a specific journal's
  // positions, so two journals on the same wallet keep independent insights.
  // Null means "wallet-wide" (legacy rows pre-multi-journal). Resolved to
  // the wallet's default journal at query time when filtering.
  journalId         String?
  observationText   String
  confidence        String?   // high | medium | low
  sourceModule      String?   // exit_optimizer | disposition_detector | tilt_detector | novel_pattern | weekly_synthesis
  relatedStrategyId String?
  relatedStrategy   Strategy? @relation(fields: [relatedStrategyId], references: [id])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  compressedAt      DateTime?
  // Statistical metadata — enables server-side filtering/sorting without parsing JSON
  impactScore       Float?
  category          String?   // exit | entry | behavior | strategy | risk | timing | pacifica
  isSignificant     Boolean?

  @@index([walletAddress, journalId])
}

// ─── Analysis Snapshots ────────────────────────────────────────────────────────

model AnalysisSnapshot {
  id                 String   @id @default(cuid())
  walletAddress      String?
  periodType         String   // daily | weekly
  periodStart        DateTime
  periodEnd          DateTime
  totalTrades        Int?
  winRate            Float?
  expectancy         Float?
  profitFactor       Float?
  sharpeRatio        Float?
  regimeBreakdown    String?  // JSON: { regime: { win_rate, expectancy, ... } }
  behavioralScores   String?  // JSON: { disposition_score, tilt_score, adherence_score }
  summaryText        String?  // ~500 token summary for Booba Layer 2
  createdAt          DateTime @default(now())
}

// ─── Funding History ───────────────────────────────────────────────────────────

model FundingHistory {
  id            String   @id @default(cuid())
  walletAddress String?
  asset         String
  amount    Float
  rate      Float
  timestamp DateTime
  tradeId   String?
  trade     Trade?   @relation(fields: [tradeId], references: [id])
  rawData   String?  // JSON
  createdAt DateTime @default(now())
}

// ─── Regime Snapshots ──────────────────────────────────────────────────────────

model RegimeSnapshot {
  id                   String   @id @default(cuid())
  asset                String
  timestamp            DateTime
  timeframe            String   // daily | hourly | etc.
  method               String   // detector name, e.g. 'adx-atr' — lets us know which algorithm produced this
  regimeClassification String?  // trending_low_vol | trending_high_vol | ranging_low_vol | ranging_high_vol | transitional
  confidence           Float?   // 0-1, how clearly this regime is established
  adxValue             Float?
  atrValue             Float?
  atrSmaValue          Float?
  createdAt            DateTime @default(now())

  @@unique([asset, timestamp, timeframe, method])
  @@index([asset, timestamp])
}

// ─── Candle Cache ──────────────────────────────────────────────────────────────
//
// Server-wide OHLCV cache, populated on demand by anything that fetches
// candles through the cache layer (exit-quality MFE/MAE, regime detection,
// trade replay). One row per (asset, timeframe, timestamp) — the `source`
// field records which backend (pacifica / bybit / binance) served the data
// so we can prefer higher-fidelity sources on refetch. Asset uses Pacifica
// symbol notation ('BTC', 'SOL', 'kPEPE') — adapters inside the cache do
// the symbol mapping for Bybit/Binance requests.

model CandleCache {
  id        String   @id @default(cuid())
  asset     String
  timeframe String   // '1m', '5m', '15m', '1h', '4h', '1d'
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String   // 'pacifica' | 'bybit' | 'binance'
  createdAt DateTime @default(now())

  @@unique([asset, timeframe, timestamp])
  @@index([asset, timeframe, timestamp])
}

// ─── Signals (Caller/Signal tracking) ─────────────────────────────────────

model Signal {
  id            String   @id @default(cuid())
  walletAddress String
  source        String   // 'discord', 'twitter', 'telegram', 'manual'
  channelName   String?  // e.g. 'alpha-calls', '@CryptoGuru'
  callerName    String   // who made the call
  rawMessage    String?  // original message text

  asset         String   // BTC, ETH, SOL
  direction     String   // LONG, SHORT
  entryPrice    Float
  targetPrice   Float?
  targetPrices  String?  // JSON array of all target prices: '[110, 114, 120]'
  stopPrice     Float?

  // Outcome tracking
  status        String   @default("open") // open, hit_target, hit_stop, partial_target, expired, closed_manual
  outcomePrice  Float?
  outcomePnlPct Float?   // percentage return
  outcomeRMultiple Float? // reward / risk
  targetPricesHit String? // JSON boolean array: '[true, true, false]' — which TPs were hit
  resolvedAt    DateTime?

  // Link to user's position if they followed this call
  positionId    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress, callerName])
  @@index([walletAddress, status])
}

// ─── Playbooks (structured strategy rules + adherence) ───────────────────────
//
// A playbook is a list of rules the trader commits to. When a position is
// tagged with a playbook, the adherence service runs each enabled rule against
// the position and stores a score (0-100) plus per-rule results on the
// position itself (adherenceScore/adherenceDetail). Rules serialised as JSON
// so adding new rule types is a code-only change — no migrations.

model Playbook {
  id              String   @id @default(cuid())
  walletAddress   String
  name            String
  description     String?

  // JSON array of PlaybookRule: { type, params, enabled, label }
  rules           String

  // Rolling stats, refreshed after each adherence check.
  totalChecks     Int      @default(0)
  avgAdherence    Float?   // 0-100 average of per-position adherenceScore

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([walletAddress])
}

// ─── Equity Snapshots (Pacifica /portfolio) ───────────────────────────────────
//
// Periodic snapshots of total account equity (cash + unrealized P&L). Source
// of truth for the equity curve and TWR daily returns when EQUITY_PROVIDER_MODE
// is 'snapshot-twr'. One row per (walletAddress, timestamp); upserted on sync.

model EquitySnapshot {
  id              String   @id @default(cuid())
  walletAddress   String
  timestamp       DateTime
  accountEquity   Float
  pnl             Float?
  source          String   @default("pacifica")
  createdAt       DateTime @default(now())

  @@unique([walletAddress, timestamp])
  @@index([walletAddress, timestamp])
}

// ─── Balance Events (Pacifica /account/balance/history) ───────────────────────
//
// Raw event log of cash flow into and out of the account: deposits,
// withdrawals, trade settlements, funding, etc. Used by the snapshot-twr
// provider to compute Time-Weighted Return (deposit/withdrawal awareness)
// and to surface starting capital fallback when no equity snapshots exist.

model BalanceEvent {
  id              String   @id @default(cuid())
  walletAddress   String
  timestamp       DateTime
  eventType       String
  amount          Float
  balance         Float?
  source          String   @default("pacifica")
  createdAt       DateTime @default(now())

  @@unique([walletAddress, timestamp, eventType, amount])
  @@index([walletAddress, timestamp])
}

// ─── Alerts ────────────────────────────────────────────────────────────────────

model Alert {
  id             String   @id @default(cuid())
  walletAddress  String?
  alertType      String   // utilization_spike | margin_warning | tilt_warning | sentiment_shift | funding_flip
  message        String
  severity       String   // info | warning | critical
  relatedTradeId String?
  relatedTrade   Trade?   @relation(fields: [relatedTradeId], references: [id])
  acknowledged   Boolean  @default(false)
  createdAt      DateTime @default(now())
}
